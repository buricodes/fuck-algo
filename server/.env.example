# development (memory store allowed, Dodo test mode) or production (live mode, DATABASE_URL required)
APP_ENV=development
PORT=8787

# Postgres connection string. Empty in development means the in memory store.
DATABASE_URL=

# AI providers. AI_CHECKS: jev | anthropic | cli. AI_RULES: cli | anthropic.
# jev needs OPEN_ROUTER_KEY. cli uses the local `claude` login (development only). anthropic needs ANTHROPIC_API_KEY.
AI_CHECKS=jev
AI_RULES=cli
OPEN_ROUTER_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Dodo Payments (all three needed for /v1/checkout and /v1/webhooks/dodo).
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PRODUCT_ID=

# Website origin, also used for the Dodo return URL <WEBSITE_URL>/thanks?session=...
WEBSITE_URL=http://localhost:3000

# Comma separated chrome-extension:// origins allowed by CORS.
# Empty allows any chrome-extension origin in development and none in production.
EXTENSION_ORIGINS=
